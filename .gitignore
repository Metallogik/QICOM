# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# Test / lint / type-check caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Build identity of one build, written by packaging/generate_build_identity.py.
# Describes a single build, not the repository: a committed copy would make
# every later checkout claim that build's revision.
qicom/_build_identity.py

# Per-build licence inventory / SBOM, written by packaging/attribution.py from
# the environment a bundle is frozen in. The reviewed notice texts under
# packaging/attribution/notices/ are tracked; the generated output is not.
packaging/attribution/THIRD_PARTY_INVENTORY.json
packaging/attribution/THIRD_PARTY_LICENSES.txt
packaging/attribution/qicom-sbom.cdx.json

# QICOM local data (session DB, logs, downloaded model weights)
*.sqlite3
*.db
*.log
/data/
/models/

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Test images (large DICOM files)
/testImages/

# Project map generated by packaging/generate_architecture_map.py
/ARCHITECTURE.md

# Results of local benchmark runs
/benchmarks/results/

# Article sources and experiment records, kept outside the software repository
/paper/
